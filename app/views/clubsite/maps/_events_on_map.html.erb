<% if events.any? %>
  <h3>Events on this map</h3>
  <table class="table table-striped table-bordered table-condensed">
    <thead>
      <tr>
        <th>Series</th>
        <th>Date</th>
      </tr>
    </thead>
    <tbody>
      <% events.each do |event| %>
        <tr>
          <td><%= event.series&.acronym.present? ? "#{event.name} (#{event.series.acronym})" : event.name %></td>
          <td><%= link_to event.local_date.strftime('%b %-d, %Y'), clubsite_event_path(id: event.id) %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% end %>

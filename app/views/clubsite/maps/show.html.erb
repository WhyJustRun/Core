<% content_for :title, @map.name %>
<header class="page-header">
  <% show_file_download = @map.file_url.present? %>
  <% if @edit || show_file_download %>
    <div class="pull-right btn-toolbar">
      <% if show_file_download %>
        <div class="btn-group">
          <a class="btn btn-info" href="/maps/download/<%= @map.id %>"><span class="glyphicon glyphicon-download-alt"></span> Download</a>
        </div>
      <% end %>
      <% if @edit %>
        <div class="btn-group">
          <a href="/maps/edit/<%= @map.id %>" class="btn btn-primary"><span class="glyphicon glyphicon-cog"></span> Edit</a>
        </div>
        <div class="btn-group">
          <%= button_to "/maps/delete/#{@map.id}", method: :post, class: 'btn btn-danger', form: { style: 'display: inline-block', onsubmit: "return confirm('Delete this map?');" } do %><span class="glyphicon glyphicon-trash"></span><% end %>
        </div>
      <% end %>
    </div>
  <% end %>
  <h1><%= @map.name %> <small>Map information</small></h1>
</header>
<div class="row">
  <div class="col-sm-5">
    <h3>Statistics</h3>
    <table class="table table-striped table-bordered table-condensed">
      <% if @map.scale.present? && @map.scale.nonzero? %>
        <tr><th>Scale</th><td>1:<%= number_with_delimiter(@map.scale) %></td></tr>
      <% end %>
      <tr><th>Map standard</th><td><%= @map.map_standard&.name %></td></tr>
      <tr><th>Events on map</th><td><%= @events.size %></td></tr>
    </table>
    <hr/>
    <% if @map.notes.present? %>
      <h3>Notes</h3>
      <%= sanitize @map.notes %>
      <hr/>
    <% end %>
    <h3>Map image</h3>
    <% if media_exists?('Map', @map.id) %>
      <%= media_linked_image('Map', @map.id, '400x600', {}, class: 'fitting-image') %>
    <% else %>
      No map image available.
    <% end %>
    <hr>
    <%= render 'events_on_map', events: @events %>
  </div>
  <div class="col-sm-7">
    <%= render 'info', map: @map %>
  </div>
</div>

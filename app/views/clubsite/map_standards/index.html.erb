<% content_for :title, 'Map Standards' %>
<header class="page-header">
  <div class="pull-right">
    <a href="/mapStandards/edit" class="btn btn-success"><span class="glyphicon glyphicon-plus"></span> Map Standard</a>
  </div>
  <h1>Map Standards</h1>
</header>
<div class="row">
  <div class="col-sm-4">
    <table class="table table-striped table-bordered table-condensed">
      <thead>
        <tr>
          <th>Name</th>
          <th>Description</th>
          <th></th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% @map_standards.each do |map_standard| %>
          <tr>
            <td><%= map_standard.name %></td>
            <td><%= map_standard.description %></td>
            <td>
              <a class="btn btn-xs btn-primary" href="/mapStandards/edit/<%= map_standard.id %>">
                <span class="glyphicon glyphicon-cog"></span>
              </a>
            </td>
            <td>
              <%= form_with url: "/mapStandards/delete/#{map_standard.id}", html: { class: 'thin-form' } do %>
                <button type="submit" class="btn btn-xs btn-danger">
                  <span class="glyphicon glyphicon-trash"></span>
                </button>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>

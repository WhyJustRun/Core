<% content_for :title, 'Privileges' %>
<header class="page-header">
  <h1>Privileges</h1>
</header>

<div class="row">
  <div class="col-sm-5">
    <h3>Types of privileges</h3>
    <dl class="dl-horizontal">
      <% @groups.each do |group| %>
        <dt><%= group.name %></dt>
        <dd><%= group.description %></dd>
      <% end %>
    </dl>
    Those users not listed here can only sign up for events and have no other privileges.
  </div>
  <div class="col-sm-7">
    <h3>Add privilege</h3>
    <%= form_with scope: :privilege, url: '/privileges/add', html: { class: 'form-inline' } do |f| %>
      <div class="form-group">
        <%= f.hidden_field :user_id, id: 'privilege_user_id' %>
        <input placeholder="Name" type="text" id="PrivilegeUserName"
               class="form-control simple-person-picker" autocomplete="off"
               data-user-id-target="#privilege_user_id"
               data-maintain-input="true" data-allow-fake="false" required />
      </div>
      <div class="form-group">
        <%= f.collection_select :group_id, @groups, :id, :name, {}, class: 'form-control' %>
      </div>
      <button type="submit" class="btn btn-success">
        <span class="glyphicon glyphicon-plus"></span> Add
      </button>
    <% end %>

    <h3>Current privileges</h3>
    <table class="table table-striped table-bordered table-condensed">
      <thead>
        <tr>
          <th>Name</th>
          <th>Group</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% @privileges.each do |privilege| %>
          <tr>
            <td style="vertical-align: middle"><%= privilege.user.name %></td>
            <td>
              <%= form_with scope: :privilege, url: "/privileges/update/#{privilege.id}",
                            method: :post, html: { class: 'form-inline' } do |f| %>
                <div class="form-group">
                  <%= f.collection_select :group_id, @groups, :id, :name,
                                          { selected: privilege.group_id },
                                          class: 'form-control input-sm' %>
                </div>
                <%= f.submit 'Save', class: 'btn btn-primary btn-sm' %>
              <% end %>
            </td>
            <td>
              <%= button_to "/privileges/delete/#{privilege.id}",
                            class: 'btn btn-sm btn-danger', form_class: 'thin-form' do %>
                <span class="glyphicon glyphicon-trash"></span>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>

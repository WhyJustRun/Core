<div class="page-header">
  <h1>Results</h1>
</div>

<div class="table-responsive">
  <table class="table table-striped table-bordered table-condensed">
    <thead>
      <tr>
        <th>Date</th>
        <th>Event</th>
        <th>Course</th>
        <th>Name</th>
        <th>Time</th>
        <th>Status</th>
      </tr>
    </thead>
    <tbody>
      <% @results.each do |result| %>
        <% event = result.course.event %>
        <tr>
          <td><%= event.local_date.strftime('%b %-d, %Y') %></td>
          <td><%= link_to event.name, clubsite_event_path(id: event.id) %></td>
          <td><%= link_to result.course.name, clubsite_course_path(id: result.course.id) %></td>
          <td><%= result.user&.name %></td>
          <td><%= result.time&.strftime('%-H:%M:%S') %></td>
          <td><%= result.readable_status %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>

<% if @total_pages > 1 %>
  <nav>
    <ul class="pager">
      <% if @page > 1 %>
        <li class="previous"><a href="<%= clubsite_results_path(page: @page - 1) %>">&larr; Previous</a></li>
      <% end %>
      <% if @page < @total_pages %>
        <li class="next"><a href="<%= clubsite_results_path(page: @page + 1) %>">Next &rarr;</a></li>
      <% end %>
    </ul>
  </nav>
<% end %>

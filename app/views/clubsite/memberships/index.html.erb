<% content_for :title, 'Memberships' %>
<header>
  <h1>Memberships</h1>
</header>
<div class="col-sm-4">
  <div class="column-box">
    <%= form_with model: @membership, url: '/memberships/edit' do |f| %>
      <div class="form-group">
        <%= f.label :user_id, 'User' %>
        <%= f.collection_select :user_id, @users, :id, :name, {}, class: 'form-control' %>
      </div>
      <div class="form-group">
        <%= f.label :year, 'Membership year' %>
        <%= f.text_field :year, class: 'form-control' %>
      </div>
      <div class="form-group">
        <%= f.label :created, 'Created' %>
        <%= f.text_field :created, value: @membership.created&.strftime('%Y-%m-%d %H:%M:%S'), class: 'form-control' %>
      </div>
      <%= f.submit 'Add membership', class: 'btn btn-primary' %>
    <% end %>
  </div>
</div>

<div class="col-sm-8">
  <div class="results-list">
    <% @memberships.group_by(&:year).each do |year, memberships| %>
      <h3>Membership year: <%= year %></h3>
      <table class="table table-striped table-condensed">
        <thead>
          <tr><th>Name</th><th></th><th></th></tr>
        </thead>
        <tbody>
          <% memberships.each do |membership| %>
            <tr>
              <td><%= membership.user&.name %></td>
              <td><%= link_to 'Edit', "/memberships/edit/#{membership.id}", class: 'btn btn-xs btn-default' %></td>
              <td>
                <%= form_with url: "/memberships/delete/#{membership.id}" do %>
                  <%= submit_tag 'Remove', class: 'btn btn-xs btn-danger' %>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% end %>
  </div>
</div>

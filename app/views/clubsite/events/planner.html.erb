<% content_for :title, 'Event Planner' %>
<header class="page-header">
  <div class="pull-right">
    <%= render 'clubsite/events/add_link' %>
  </div>
  <h1>Event Planner</h1>
</header>

<div class="row">
  <div class="col-sm-6">
    <h2>Which Map?</h2>
    <table class="table table-striped table-bordered table-condensed">
      <thead>
        <tr>
          <th>Name</th>
          <th>Last Used</th>
        </tr>
      </thead>
      <tbody>
        <% @maps.each do |map, last_event| %>
          <tr>
            <td><a href="/maps/view/<%= map.id %>"><%= map.name %></a></td>
            <td>
              <% if last_event %>
                <a href="/events/view/<%= last_event.id %>" target="_blank">
                  <%= time_ago_in_words(last_event.date) %> ago
                </a>
              <% else %>
                Never used
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <div class="col-sm-6">
    <h2>Who's Next?</h2>
    <p>A list of people who have attended at least <%= @attendance_threshold %> events since <%= time_ago_in_words(@date_threshold) %> ago, but haven't volunteered as an organizer.</p>
    <table class="table table-striped table-bordered table-condensed">
      <thead>
        <tr>
          <th>Name</th>
          <th>Attended</th>
        </tr>
      </thead>
      <tbody>
        <% @volunteers.each do |user, attended| %>
          <tr>
            <td>
              <a href="<%= profile_url(user) %>" target="_blank"><%= user.name %></a>
            </td>
            <td>
              <%= attended %> events
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>

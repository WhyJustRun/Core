<% content_for :title, 'Clubs' %>
<header class="page-header">
  <h1>Clubs</h1>
</header>
<table class="table table-striped table-bordered table-condensed">
  <thead>
    <tr>
      <th>Name</th>
      <th>Acronym</th>
      <th>Location</th>
    </tr>
  </thead>
  <tbody>
    <% @clubs.each do |club| %>
      <tr>
        <td><%= club.url.present? ? link_to(club.name, club.url) : club.name %></td>
        <td><%= club.acronym %></td>
        <td><%= club.location %></td>
      </tr>
    <% end %>
  </tbody>
</table>

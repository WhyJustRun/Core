<% content_for :title, @page.name %>
<% can_edit = user_signed_in? && current_user.has_privilege?(Settings.privileges.page.edit, current_club) %>
<% can_delete = user_signed_in? && current_user.has_privilege?(Settings.privileges.page.delete, current_club) %>

<header class="page-header">
  <% if can_delete %>
    <div class="pull-right">
      <div class="btn-group">
        <%= button_to "/pages/delete/#{@page.id}", class: 'btn btn-danger',
                      form: { onsubmit: 'return confirm("Are you sure you want to delete the page?");' } do %>
          <span class="glyphicon glyphicon-trash"></span>
        <% end %>
      </div>
    </div>
  <% end %>
  <h1 id="page-resource-title-<%= @page.id %>" class="page-resource-title <%= 'wjr-editable' if can_edit %>"><%= @page.name %></h1>
</header>

<div id="page-resource-<%= @page.id %>" class="page-resource <%= 'wjr-editable' if can_edit %>">
  <%= raw @page.content %>
</div>

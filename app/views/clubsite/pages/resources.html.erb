<% content_for :title, 'Resources' %>
<header class="page-header">
  <h1>Resources</h1>
</header>

<% if @pages.empty? %>
  <h3>Sorry, no resources are posted yet.</h3>
<% end %>
<% @pages.each do |page| %>
  <h3><%= link_to page.name, "/pages/#{page.id}" %></h3>
<% end %>

<% if user_signed_in? && current_user.has_privilege?(Settings.privileges.page.edit, current_club) %>
  <hr>
  <h2>Add page</h2>
  <%= form_with scope: :page, url: '/pages/add', html: { class: 'form-horizontal' } do |f| %>
    <fieldset class="form-group">
      <%= f.label :name, 'Name', class: 'control-label col-sm-2' %>
      <div class="col-sm-10">
        <%= f.text_field :name, class: 'form-control', 'data-validate' => 'validate(required)' %>
      </div>
    </fieldset>
    <fieldset class="form-group">
      <%= f.label :content, 'Content', class: 'control-label col-sm-2' %>
      <div class="col-sm-10">
        <%= f.text_area :content, class: 'wjr-wysiwyg', rows: 20, 'data-validate' => 'validate(required)' %>
      </div>
    </fieldset>
    <%= f.submit 'Add', class: 'btn btn-primary' %>
  <% end %>
<% end %>

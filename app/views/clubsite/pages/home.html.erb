<div class="three-column row">
  <article class="col-sm-4 col-sm-push-4">
    <header>
      <h2>Events</h2>
    </header>
    <% if current_club.layout == 'series' %>
      <%= render 'clubsite/events/summary_list_by_series' %>
    <% else %>
      <%= render 'clubsite/events/summary_list' %>
    <% end %>

    <div class="event-list"
         data-event-list-url="/club/<%= current_club.id %>/events.xml?iof_version=3.0&amp;start=<%= Time.current.to_i %>&amp;club_events=significant&amp;external_significant_events=all">
      <h3 data-bind="visible: events().length > 0">Highlights</h3>
      <div data-bind="template: { name: 'event-box-template', foreach: events }"></div>
    </div>
    <%= render 'clubsite/events/knockout_box', template_name: 'event-box-template' %>

    <div style="text-align: center">
      <%= render 'clubsite/events/add_link' %>
    </div>
  </article>

  <article class="col-sm-4 col-sm-push-4">
    <header>
      <h2>News</h2>
    </header>
    <% if current_club.juicer_feed_id.blank? && user_signed_in? && current_user.has_privilege?(Settings.privileges.club.edit, current_club) %>
      <a class="btn" href="/clubs/edit">Add news source</a>
    <% end %>
    <%= render 'clubsite/shared/juicer_feed' %>
    <%= render 'clubsite/shared/facebook_like' %>
  </article>
  <article class="col-sm-4 col-sm-pull-8">
    <%= render_content_blocks 'general_information' %>
  </article>
</div>
